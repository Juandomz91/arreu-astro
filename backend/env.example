# Dominis des dels quals es pot enviar el formulari (separats per comes).
# En producció: el domini del web, p. ex. https://campersgirona.com
ALLOWED_ORIGINS=https://campersgirona.com

# Servidor de correu (SMTP). SMTP_HOST i CONTACT_TO_EMAIL són obligatoris
# perquè el formulari enviï correus; sense ells, el formulari respon amb error.
# Port 587 = STARTTLS, port 465 = SSL directe.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Remitent (ha de ser una adreça que el teu proveïdor SMTP et deixi fer servir;
# si es deixa buit, s'usa SMTP_USER) i destinatari dels missatges del formulari.
SMTP_FROM=
CONTACT_TO_EMAIL=
