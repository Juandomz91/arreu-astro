---
// <head> comú a totes les pàgines: títol, descripció, idiomes alternatius,
// previsualització a xarxes (Open Graph) i dades estructurades per a Google.
import { getT, LANGUAGES, DEFAULT_LANG, langUrl } from '../i18n/translations.js';
import { SITE_URL, BUSINESS, SOCIAL } from '../config.js';

const { lang } = Astro.props;
const t = getT(lang);

const pageUrl = SITE_URL + langUrl(lang);
const ogImage = SITE_URL + '/video/hero-poster.jpg';
const ogLocales = { ca: 'ca_ES', es: 'es_ES', en: 'en_GB', fr: 'fr_FR' };

// Dades per a Google (negoci local). Si el taller té adreça física,
// afegeix streetAddress i postalCode dins d'address.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AutomotiveBusiness',
  name: BUSINESS.name,
  description: t('meta.description'),
  url: SITE_URL + '/',
  logo: SITE_URL + '/logo.svg',
  image: ogImage,
  telephone: BUSINESS.phone,
  email: BUSINESS.email,
  address: {
    '@type': 'PostalAddress',
    addressLocality: BUSINESS.city,
    addressRegion: BUSINESS.region,
    addressCountry: BUSINESS.country,
  },
  areaServed: BUSINESS.region,
  sameAs: [SOCIAL.instagram, SOCIAL.youtube].filter((u) => u.split('/').filter(Boolean).length > 2),
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{t('meta.title')}</title>
    <meta name="description" content={t('meta.description')} />
    <link rel="canonical" href={pageUrl} />

    {/* Versions en altres idiomes: així Google ensenya a cadascú la seva */}
    {LANGUAGES.map((lng) => <link rel="alternate" hreflang={lng} href={SITE_URL + langUrl(lng)} />)}
    <link rel="alternate" hreflang="x-default" href={SITE_URL + langUrl(DEFAULT_LANG)} />

    {/* Com es veu l'enllaç en compartir-lo (WhatsApp, Instagram, Facebook...) */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={BUSINESS.name} />
    <meta property="og:title" content={t('meta.title')} />
    <meta property="og:description" content={t('meta.description')} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={ogLocales[lang]} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&display=swap" rel="stylesheet" />

    <slot name="head" />
  </head>
  <body style="margin:0">
    <slot />
  </body>
</html>
