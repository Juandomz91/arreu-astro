---
// <head> comú a totes les pàgines: títol, descripció, idiomes alternatius,
// previsualització a xarxes (Open Graph) i dades estructurades per a Google.
import { getT, LANGUAGES, DEFAULT_LANG, langUrl } from '../i18n/translations.js';
import { SITE_URL, BUSINESS, SOCIAL } from '../config.js';

const { lang } = Astro.props;
const t = getT(lang);

const pageUrl = SITE_URL + langUrl(lang);
const ogImage = SITE_URL + '/video/hero-poster.jpg';
const ogLocales = { ca: 'ca_ES', es: 'es_ES', en: 'en_GB', fr: 'fr_FR' };

// Dades per a Google (negoci local). Si el taller té adreça física,
// afegeix streetAddress i postalCode dins d'address.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AutomotiveBusiness',
  name: BUSINESS.name,
  description: t('meta.description'),
  url: SITE_URL + '/',
  logo: SITE_URL + '/logo.svg',
  image: ogImage,
  telephone: BUSINESS.phone,
  email: BUSINESS.email,
  address: {
    '@type': 'PostalAddress',
    addressLocality: BUSINESS.city,
    addressRegion: BUSINESS.region,
    addressCountry: BUSINESS.country,
  },
  areaServed: BUSINESS.region,
  sameAs: [SOCIAL.instagram, SOCIAL.youtube].filter((u) => u.split('/').filter(Boolean).length > 2),
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{t('meta.title')}</title>
    <meta name="description" content={t('meta.description')} />
    <link rel="canonical" href={pageUrl} />

    {/* Versions en altres idiomes: així Google ensenya a cadascú la seva */}
    {LANGUAGES.map((lng) => <link rel="alternate" hreflang={lng} href={SITE_URL + langUrl(lng)} />)}
    <link rel="alternate" hreflang="x-default" href={SITE_URL + langUrl(DEFAULT_LANG)} />

    {/* Com es veu l'enllaç en compartir-lo (WhatsApp, Instagram, Facebook...) */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={BUSINESS.name} />
    <meta property="og:title" content={t('meta.title')} />
    <meta property="og:description" content={t('meta.description')} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={ogLocales[lang]} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&display=swap" rel="stylesheet" />

    {/* Estils globals: scroll suau fins a les seccions i menú de navegació */}
    <style is:global>
      :root { --nav-h: 72px; } /* alçada del Nav; Nav.jsx la corregeix amb la mida real */
      html { scroll-behavior: smooth; scroll-padding-top: var(--nav-h); }
      @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }

      .nav-links { display: flex; gap: 28px; list-style: none; margin: 0; padding: 0; }
      .nav-link {
        font-family: 'IBM Plex Mono', monospace; font-size: 15px; font-weight: 600;
        text-transform: uppercase; letter-spacing: 1px; color: #141310; text-decoration: none;
        padding: 4px 0; border-bottom: 2px solid transparent;
      }
      .nav-link:hover { border-bottom-color: #e35a1c; }
      .nav-link:focus-visible { outline: 2px solid #e35a1c; outline-offset: 4px; }

      /* Mòbil: els enllaços passen a una segona fila, a tota l'amplada */
      @media (max-width: 700px) {
        :root { --nav-h: 94px; }
        .nav { padding: 12px 16px !important; }
        .nav-links { order: 3; width: 100%; justify-content: space-between; gap: 8px; margin-top: 12px; }
        .nav-link { font-size: 13px; letter-spacing: 0; }
      }
    </style>

    <slot name="head" />
  </head>
  <body style="margin:0">
    <slot />
  </body>
</html>
