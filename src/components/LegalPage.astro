---
// Plantilla de les pàgines legals (Avís legal i Política de privacitat).
// El contingut surt de src/i18n/legal-docs.js i les dades del titular de src/legal-data.js.
// Les adreces es defineixen a src/pages/[doc].astro i src/pages/[lang]/[doc].astro.
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from './Footer.astro';
import { getLegalDoc } from '../i18n/legal-docs.js';
import { getLegalUI, legalUrl } from '../i18n/legal-ui.js';
import { LANGUAGES, langUrl } from '../i18n/translations.js';
import { BUSINESS } from '../config.js';

const { lang, doc } = Astro.props; // doc: 'legal' | 'privacy'
const ui = getLegalUI(lang);
const page = getLegalDoc(lang, doc);
const alternates = LANGUAGES.map((lng) => ({ lang: lng, path: legalUrl(lng, doc) }));
---
<BaseLayout
  lang={lang}
  title={`${page.title} | ${BUSINESS.name}`}
  description={page.description}
  path={page.path}
  alternates={alternates}
  schema={false}
>
  <div class="page">
    <header class="legal-header">
      <a class="back" href={langUrl(lang)}><span aria-hidden="true">←</span> {ui.back}</a>
      <nav aria-label={ui.langNav}>
        {LANGUAGES.map((lng) => (
          <a
            href={legalUrl(lng, doc)}
            lang={lng}
            hreflang={lng}
            class:list={['lang', { current: lng === lang }]}
            aria-current={lng === lang ? 'page' : undefined}
          >{lng.toUpperCase()}</a>
        ))}
      </nav>
    </header>

    <main class="legal">
      <h1>{page.title}</h1>
      {page.sections.map((section, i) => (
        <section>
          <h2>{i + 1}. {section.h}</h2>
          {section.body.map((block) =>
            typeof block === 'string' ? (
              <p set:html={block} />
            ) : (
              <ul>{block.list.map((item) => <li set:html={item} />)}</ul>
            ),
          )}
        </section>
      ))}
      <p class="updated">{ui.updated}: {page.updated}</p>
    </main>

    <Footer lang={lang} />
  </div>
</BaseLayout>

<style>
  .page {
    min-height: 100vh; display: flex; flex-direction: column;
    background: #eef2ea; color: #3a3830;
    font-family: 'IBM Plex Mono', monospace;
  }
  .legal-header {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
    gap: 12px 16px; padding: 16px 28px;
    background: #eef2ea; border-bottom: 2px solid #141310;
  }
  .back, .lang {
    color: #141310; text-decoration: none; font-weight: 600;
    font-size: 14px; text-transform: uppercase; letter-spacing: 1px;
    padding: 4px 0; border-bottom: 2px solid transparent;
  }
  .back:hover, .lang:hover { border-bottom-color: #e35a1c; }
  .back:focus-visible, .lang:focus-visible { outline: 2px solid #e35a1c; outline-offset: 4px; }
  nav { display: flex; gap: 16px; }
  .lang.current { border-bottom-color: #141310; }

  .legal { flex: 1; width: 100%; max-width: 760px; margin: 0 auto; padding: 48px 24px 72px; box-sizing: border-box; }
  h1 {
    margin: 0 0 32px; color: #141310; text-transform: uppercase; line-height: 1.1;
    font-size: clamp(28px, 5vw, 44px); overflow-wrap: anywhere;
  }
  h2 { margin: 36px 0 12px; color: #141310; font-size: 20px; line-height: 1.3; }
  section :global(p), section :global(li) { font-size: 16px; line-height: 1.7; }
  section :global(p) { margin: 0 0 12px; }
  section :global(ul) { margin: 0 0 12px; padding-left: 22px; }
  section :global(li) { margin-bottom: 6px; overflow-wrap: anywhere; }
  .legal :global(a) { color: #141310; text-decoration: underline; text-underline-offset: 3px; }
  .legal :global(a:hover) { text-decoration-color: #e35a1c; text-decoration-thickness: 2px; }
  .legal :global(a:focus-visible) { outline: 2px solid #e35a1c; outline-offset: 3px; }
  /* Dada del titular encara per omplir (src/legal-data.js): s'ha de veure bé perquè no es publiqui així */
  .legal :global(mark.pending) { background: #ffd84d; color: #141310; padding: 0 4px; }
  .updated { margin-top: 40px; font-size: 14px; color: #5a5850; }
</style>
