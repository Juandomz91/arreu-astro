# URL del backend (FastAPI). Si no la defineixes, el formulari envia a /api
# (en desenvolupament, el proxy d'astro.config.mjs ho porta a localhost:8000).
# En Astro, les variables visibles al navegador han de començar per PUBLIC_
# IMPORTANT: s'incrusta en compilar; si la canvies, cal tornar a desplegar el web.
PUBLIC_API_URL=https://api.arreucampers.cat/api
